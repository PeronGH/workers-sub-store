{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sub-store",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "build": {
    "command": "node scripts/build-core.mjs",
    "watch_dir": "scripts"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Asset matching ignores the query string, so `/?url=...` must reach the Worker first.
    "run_worker_first": ["/"]
  }
}
